	return r
fn asSound(n: Node) -> Sound:
	var r = sounds.get(n.id)
	if r == null:
		throw f"node '{n.name()}' is a {n.kind()}, not a Sound"
	return r

# ---- entry points. The generated game file re-exports these with bare names (snc mangles exports of imported modules) ----
fn nbReady(id: Int):
	var n = wrap(id)
	n.nbConnect()
	n.onReady()

fn nbFrame(id: Int, delta: Float):
	var n = nodes.get(id)
	if n != null:
		n.onFrame(delta)

fn nbTick(id: Int, rate: Int, delta: Float):
	var n = nodes.get(id)
	if n != null:
		n.nbTickDispatch(rate, delta)

fn nbEvery(id: Int, ms: Int, delta: Float):
	var n = nodes.get(id)
	if n != null:
		n.nbEveryDispatch(ms, delta)

fn nbFire(id: Int, name: String, a: Float, b: Float, other: Int):
	wrap(id).nbFire(name, a, b, other)

# the node is being freed: run its hook, send `freed`, forget it
fn nbFreed(id: Int):
	var n = nodes.get(id)
	if n != null:
		n.onFree()
		n.freed.send()
		nodes.remove(id)
		node2ds.remove(id)
		sprites.remove(id)
		shapes.remove(id)
		labels.remove(id)
		buttons.remove(id)
		bodies.remove(id)
		spawnables.remove(id)
		tilemaps.remove(id)
		cameras.remove(id)
		sounds.remove(id)
