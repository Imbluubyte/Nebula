# nebula.sn - the scripting API Nebula ships to every game. Plain SuperNova.
# The engine (Kotlin) implements the `extern fn` block and calls the `export fn` block.
# Node ids are Ints. Game scripts never touch ids: they use the Node classes below.

use std.math

# ---- provided by the engine -------------------------------------------------
extern fn nb_log(message: String)
extern fn nb_find(from: Int, path: String) -> Int
extern fn nb_parent(id: Int) -> Int
extern fn nb_type(id: Int) -> String
extern fn nb_child_count(id: Int) -> Int
extern fn nb_child_at(id: Int, index: Int) -> Int
extern fn nb_add(parent: Int, kind: String, name: String) -> Int
extern fn nb_spawn(scene: String, parent: Int) -> Int
extern fn nb_free(id: Int)
extern fn nb_has(id: Int, prop: String) -> Bool
extern fn nb_alive(id: Int) -> Bool
extern fn nb_get_f(id: Int, prop: String) -> Float
extern fn nb_get_s(id: Int, prop: String) -> String
extern fn nb_get_b(id: Int, prop: String) -> Bool
extern fn nb_set_f(id: Int, prop: String, value: Float)
extern fn nb_set_s(id: Int, prop: String, value: String)
extern fn nb_set_b(id: Int, prop: String, value: Bool)
extern fn nb_tag(id: Int, tag: String, on: Bool)
extern fn nb_has_tag(id: Int, tag: String) -> Bool
extern fn nb_tagged_count(tag: String) -> Int
extern fn nb_tagged_at(tag: String, index: Int) -> Int
extern fn nb_down(action: String) -> Bool
extern fn nb_axis(negative: String, positive: String) -> Float
extern fn nb_touch_count() -> Int
extern fn nb_touch_x(index: Int) -> Float
extern fn nb_touch_y(index: Int) -> Float
extern fn nb_screen_w() -> Float
extern fn nb_screen_h() -> Float
extern fn nb_sound(file: String)
extern fn nb_goto(scene: String)
extern fn nb_store(key: String, value: String)
extern fn nb_fetch(key: String) -> String

# ---- registries (one per node class, so `@Path as Type` can hand back the real class) ----
var nodes: Dict[Int, Node] = {}
var node2ds: Dict[Int, Node2D] = {}
var sprites: Dict[Int, Sprite] = {}
var shapes: Dict[Int, Shape] = {}
var labels: Dict[Int, Label] = {}
var buttons: Dict[Int, Button] = {}
var bodies: Dict[Int, Body] = {}
var spawnables: Dict[Int, SpawnableBody] = {}
var tilemaps: Dict[Int, TileMap] = {}
var cameras: Dict[Int, Camera] = {}
var sounds: Dict[Int, Sound] = {}

# ---- small value types ---------------------------------------------------------
class Vec2:
	var x = 0.0
	var y = 0.0
	fn onCreation(x: Float = 0.0, y: Float = 0.0):
		self.x = x
		self.y = y
	fn plus(o: Vec2) -> Vec2:
		return Vec2(x + o.x, y + o.y)
	fn minus(o: Vec2) -> Vec2:
		return Vec2(x - o.x, y - o.y)
	fn times(k: Float) -> Vec2:
		return Vec2(x * k, y * k)
	fn length() -> Float:
		return math.sqrt(x * x + y * y)
	fn distanceTo(o: Vec2) -> Float:
		return minus(o).length()
	fn normalized() -> Vec2:
		var l = length()
		if l == 0.0:
			return Vec2(0.0, 0.0)
		return Vec2(x / l, y / l)
	fn toString() -> String:
		return f"({x}, {y})"

# ---- broadcasts -------------------------------------------------------------------
# A broadcast keeps (handler, owner) pairs. Handlers whose owner node was freed are skipped.
class Bc0:
	var handlers: List[Fn()] = []
	var owners: List[Int] = []
	fn connect(handler: Fn(), owner: Int):
		handlers.add(handler)
		owners.add(owner)
	fn send():
		for i in 1..handlers.length():
			if nb_alive(owners[i]):
				handlers[i]()

class BcNode:
	var handlers: List[Fn(Node)] = []
	var owners: List[Int] = []
	fn connect(handler: Fn(Node), owner: Int):
		handlers.add(handler)
		owners.add(owner)
	fn send(other: Node):
		for i in 1..handlers.length():
			if nb_alive(owners[i]):
				handlers[i](other)

class BcPoint:
	var handlers: List[Fn(Float, Float)] = []
	var owners: List[Int] = []
	fn connect(handler: Fn(Float, Float), owner: Int):
		handlers.add(handler)
		owners.add(owner)
	fn send(x: Float, y: Float):
		for i in 1..handlers.length():
			if nb_alive(owners[i]):
				handlers[i](x, y)

class BcFloat:
	var handlers: List[Fn(Float)] = []
	var owners: List[Int] = []
	fn connect(handler: Fn(Float), owner: Int):
		handlers.add(handler)
		owners.add(owner)
	fn send(value: Float):
		for i in 1..handlers.length():
			if nb_alive(owners[i]):
				handlers[i](value)

# ---- nodes ----------------------------------------------------------------------------
class Node:
	var id = 0
	var freed = Bc0()
	fn onCreation(id: Int):
		self.id = id
		nodes[id] = self

	# lifecycle hooks: override them in a script
	fn onReady():
		pass
	fn onFrame(delta: Float):
		pass
	fn onFree():
		pass
	# the engine calls these two; generated script code overrides them
	fn nbTickDispatch(rate: Int, delta: Float):
		pass
	fn nbEveryDispatch(ms: Int, delta: Float):
		pass
	fn nbFire(name: String, a: Float, b: Float, other: Int):
		pass
	# generated code overrides this to connect the fn onHear(...) handlers; runs just before onReady
	fn nbConnect():
		pass

	# tree
	fn name() -> String:
		return nb_get_s(id, "name")
	fn rename(value: String):
		nb_set_s(id, "name", value)
	fn kind() -> String:
		return nb_type(id)
	fn parent() -> Node:
		var p = nb_parent(id)
		if p == 0:
			throw f"node '{name()}' has no parent"
		return wrap(p)
	fn childCount() -> Int:
		return nb_child_count(id)
	fn child(index: Int) -> Node:
		return wrap(nb_child_at(id, index))
	fn children() -> List[Node]:
		var out: List[Node] = []
		for i in 1..nb_child_count(id):
			out.add(wrap(nb_child_at(id, i)))
		return out
	fn add(kind: String, name: String) -> Node:
		return wrap(nb_add(id, kind, name))
	fn free():
		nb_free(id)
	fn alive() -> Bool:
		return nb_alive(id)
	fn tag(label: String):
		nb_tag(id, label, true)
	fn untag(label: String):
		nb_tag(id, label, false)
	fn hasTag(label: String) -> Bool:
		return nb_has_tag(id, label)

	# helpers every script can call bare
	fn log(message):
		nb_log(str(message))
	fn isDown(action: String) -> Bool:
		return nb_down(action)
	fn axis(negative: String, positive: String) -> Float:
		return nb_axis(negative, positive)
	fn play(file: String):
		nb_sound(file)
	fn goto(scene: String):
		nb_goto(scene)
	fn touches() -> List[Vec2]:
		var out: List[Vec2] = []
		for i in 1..nb_touch_count():
			out.add(Vec2(nb_touch_x(i), nb_touch_y(i)))
		return out
	fn screenSize() -> Vec2:
		return Vec2(nb_screen_w(), nb_screen_h())
	# spawning SpawnableBody scenes: spawnBody makes one, spawnBurst fires a ring of them outwards, spawnRing places them round a point
	fn spawnBody(scene: String, parent: Node, px: Float, py: Float) -> SpawnableBody:
		var made = nb_spawn(scene, parent.id)
		if made == 0:
			throw f"cannot spawn '{scene}'"
		wrap(made)
		var found = spawnables.get(made)
		if found == null:
			throw f"the root node of '{scene}' must be a SpawnableBody"
		found.setPosition(px, py)
		return found
	fn spawnBurst(scene: String, parent: Node, px: Float, py: Float, count: Int, speed: Float, startAngle: Float = 0.0) -> List[SpawnableBody]:
		var out: List[SpawnableBody] = []
		for i in 1..count:
			var b = spawnBody(scene, parent, px, py)
			b.launch(startAngle + 360.0 * (i - 1) / count, speed)
			out.add(b)
		return out
	fn spawnRing(scene: String, parent: Node, cx: Float, cy: Float, count: Int, radius: Float, startAngle: Float = 0.0) -> List[SpawnableBody]:
		var out: List[SpawnableBody] = []
		for i in 1..count:
			var a = math.toRadians(startAngle + 360.0 * (i - 1) / count)
			out.add(spawnBody(scene, parent, cx + math.cos(a) * radius, cy + math.sin(a) * radius))
		return out
	# how many live nodes carry this tag, and the closest one to a point (check the count first: nearest throws when there is none)
	fn countTagged(label: String) -> Int:
		return nb_tagged_count(label)
	fn nearest(label: String, fromX: Float, fromY: Float) -> Node2D:
		var best = 0
		var bestDist = 0.0
		for i in 1..nb_tagged_count(label):
			var other = nb_tagged_at(label, i)
			if nb_has(other, "x") and nb_alive(other):
				var dx = nb_get_f(other, "x") - fromX
				var dy = nb_get_f(other, "y") - fromY
				var d = dx * dx + dy * dy
				if best == 0 or d < bestDist:
					best = other
					bestDist = d
		if best == 0:
			throw f"no node tagged '{label}'"
		return asNode2D(wrap(best))
	fn save(key: String, value):
		nb_store(key, str(value))
	fn load(key: String, fallback: String = "") -> String:
		var v = nb_fetch(key)
		if v == "":
			return fallback
		return v

class Node2D extends Node:
	var tapped = BcPoint()
	fn onCreation(id: Int):
		super.onCreation(id)
		node2ds[id] = self
	fn nbFire(name: String, a: Float, b: Float, other: Int):
		if name == "tapped":
			tapped.send(a, b)
	fn x() -> Float:
		return nb_get_f(id, "x")
	fn y() -> Float:
		return nb_get_f(id, "y")
	fn position() -> Vec2:
		return Vec2(nb_get_f(id, "x"), nb_get_f(id, "y"))
	fn setPosition(x: Float, y: Float):
		nb_set_f(id, "x", x)
		nb_set_f(id, "y", y)
	fn moveBy(dx: Float, dy: Float):
		nb_set_f(id, "x", nb_get_f(id, "x") + dx)
		nb_set_f(id, "y", nb_get_f(id, "y") + dy)
	fn rotation() -> Float:
		return nb_get_f(id, "rotation")
	fn setRotation(degrees: Float):
		nb_set_f(id, "rotation", degrees)
	fn turnBy(degrees: Float):
		nb_set_f(id, "rotation", nb_get_f(id, "rotation") + degrees)
	fn scale() -> Float:
		return nb_get_f(id, "scale")
	fn setScale(value: Float):
		nb_set_f(id, "scale", value)
	fn visible() -> Bool:
		return nb_get_b(id, "visible")
	fn setVisible(value: Bool):
		nb_set_b(id, "visible", value)
	fn layer() -> Float:
		return nb_get_f(id, "layer")
	fn setLayer(value: Float):
		nb_set_f(id, "layer", value)
	fn touchable() -> Bool:
		return nb_get_b(id, "touchable")
	fn setTouchable(value: Bool):
		nb_set_b(id, "touchable", value)

class Sprite extends Node2D:
	var animationFinished = Bc0()
	fn onCreation(id: Int):
		super.onCreation(id)
		sprites[id] = self
	fn nbFire(name: String, a: Float, b: Float, other: Int):
		if name == "animationFinished":
			animationFinished.send()
		else:
			super.nbFire(name, a, b, other)
	fn image() -> String:
		return nb_get_s(id, "image")
	fn setImage(file: String):
		nb_set_s(id, "image", file)
	fn flipX() -> Bool:
		return nb_get_b(id, "flipX")
	fn setFlipX(value: Bool):
		nb_set_b(id, "flipX", value)
	# sprite sheets: frames are numbered from 1 (left to right, top to bottom); clips come from the sprite's animation set
	fn animate(clip: String):
		nb_set_s(id, "animation", clip)
		nb_set_b(id, "playing", true)
	fn stopAnimating():
		nb_set_b(id, "playing", false)
	fn animation() -> String:
		return nb_get_s(id, "animation")
	fn isAnimating() -> Bool:
		return nb_get_b(id, "playing")
	fn setAnimSpeed(value: Float):
		nb_set_f(id, "speed", value)
	fn setAnimations(file: String):
		nb_set_s(id, "animations", file)
	fn frame() -> Float:
		return nb_get_f(id, "frame")
	fn setFrame(number: Float):
		nb_set_f(id, "frame", number)

class Shape extends Node2D:
	fn onCreation(id: Int):
		super.onCreation(id)
		shapes[id] = self
	fn color() -> String:
		return nb_get_s(id, "color")
	fn setColor(hex: String):
		nb_set_s(id, "color", hex)
	fn width() -> Float:
		return nb_get_f(id, "width")
	fn height() -> Float:
		return nb_get_f(id, "height")
	fn setSize(w: Float, h: Float):
		nb_set_f(id, "width", w)
		nb_set_f(id, "height", h)

class Label extends Node2D:
	fn onCreation(id: Int):
		super.onCreation(id)
		labels[id] = self
	fn text() -> String:
		return nb_get_s(id, "text")
	fn setText(value):
		nb_set_s(id, "text", str(value))
	fn setColor(hex: String):
		nb_set_s(id, "color", hex)
	fn setFontSize(value: Float):
		nb_set_f(id, "fontSize", value)

class Button extends Node2D:
	fn onCreation(id: Int):
		super.onCreation(id)
		buttons[id] = self
		nb_set_b(id, "touchable", true)
	fn text() -> String:
		return nb_get_s(id, "text")
	fn setText(value):
		nb_set_s(id, "text", str(value))

class Body extends Node2D:
	var collided = BcNode()
	fn onCreation(id: Int):
		super.onCreation(id)
		bodies[id] = self
	fn nbFire(name: String, a: Float, b: Float, other: Int):
		if name == "collided":
			collided.send(wrap(other))
		else:
			super.nbFire(name, a, b, other)
	fn velocity() -> Vec2:
		return Vec2(nb_get_f(id, "vx"), nb_get_f(id, "vy"))
	fn setVelocity(vx: Float, vy: Float):
		nb_set_f(id, "vx", vx)
		nb_set_f(id, "vy", vy)
	fn push(dvx: Float, dvy: Float):
		nb_set_f(id, "vx", nb_get_f(id, "vx") + dvx)
		nb_set_f(id, "vy", nb_get_f(id, "vy") + dvy)
	fn setGravity(value: Float):
		nb_set_f(id, "gravity", value)
	fn onGround() -> Bool:
		return nb_get_b(id, "onGround")

# A Body built to be spawned many times (bullets, enemies, pickups). Make a scene whose root is a SpawnableBody, then
# spawnBody("scenes/bullet.nscn", parent, x, y). The engine frees it when its lifetime runs out; hurt/die/launch/chase are below.
class SpawnableBody extends Body:
	var expired = Bc0()
	var died = Bc0()
	var damaged = BcFloat()
	fn onCreation(id: Int):
		super.onCreation(id)
		spawnables[id] = self
	fn nbFire(name: String, a: Float, b: Float, other: Int):
		if name == "expired":
			expired.send()
		else:
			super.nbFire(name, a, b, other)
	# lifetime in seconds (0 = lives until freed); age counts up from the moment it was spawned
	fn lifetime() -> Float:
		return nb_get_f(id, "lifetime")
	fn setLifetime(seconds: Float):
		nb_set_f(id, "lifetime", seconds)
	fn age() -> Float:
		return nb_get_f(id, "_age")
	# health: hurt() lowers it and calls die() at 0. setMaxHealth also refills health.
	fn health() -> Float:
		return nb_get_f(id, "health")
	fn maxHealth() -> Float:
		return nb_get_f(id, "maxHealth")
	fn setHealth(value: Float):
		nb_set_f(id, "health", value)
	fn setMaxHealth(value: Float):
		nb_set_f(id, "maxHealth", value)
		nb_set_f(id, "health", value)
	fn isDead() -> Bool:
		return nb_get_b(id, "_dead")
	fn hurt(amount: Float):
		if nb_get_b(id, "_dead"):
			return
		var left = nb_get_f(id, "health") - amount
		if left < 0.0:
			left = 0.0
		nb_set_f(id, "health", left)
		damaged.send(amount)
		if left <= 0.0:
			die()
	fn heal(amount: Float):
		var up = nb_get_f(id, "health") + amount
		if up > nb_get_f(id, "maxHealth"):
			up = nb_get_f(id, "maxHealth")
		nb_set_f(id, "health", up)
	fn die():
		if nb_get_b(id, "_dead"):
			return
		nb_set_b(id, "_dead", true)
		nb_set_f(id, "health", 0.0)
		died.send()
		free()
	# damage this body deals; dealDamage(other) hurts another SpawnableBody by it (false if other is not one)
	fn damage() -> Float:
		return nb_get_f(id, "damage")
	fn setDamage(value: Float):
		nb_set_f(id, "damage", value)
	fn dealDamage(other: Node) -> Bool:
		if nb_get_b(id, "_dead"):
			return false
		var target = spawnables.get(other.id)
		if target == null:
			return false
		target.hurt(nb_get_f(id, "damage"))
		return true
	# movement: angles are degrees, 0 = right, 90 = down (screen coordinates)
	fn launch(angle: Float, speed: Float):
		var r = math.toRadians(angle)
		nb_set_f(id, "vx", math.cos(r) * speed)
		nb_set_f(id, "vy", math.sin(r) * speed)
		nb_set_f(id, "rotation", angle)
	fn angleTo(tx: Float, ty: Float) -> Float:
		return math.toDegrees(math.atan2(ty - nb_get_f(id, "y"), tx - nb_get_f(id, "x")))
	fn launchAt(target: Node2D, speed: Float):
		launch(angleTo(target.x(), target.y()), speed)
	# call every frame (onFrame) to walk straight at a node, e.g. an enemy chasing the player
	fn chase(target: Node2D, speed: Float):
		var dx = target.x() - nb_get_f(id, "x")
		var dy = target.y() - nb_get_f(id, "y")
		var d = math.hypot(dx, dy)
		if d < 1.0:
			nb_set_f(id, "vx", 0.0)
			nb_set_f(id, "vy", 0.0)
		else:
			nb_set_f(id, "vx", dx / d * speed)
			nb_set_f(id, "vy", dy / d * speed)

# A grid of tiles cut from one picture. Tile 0 is empty, 1.. count the picture's cells left to right, top to bottom.
# Columns and rows are numbered from 1. Changes show immediately and (if the map is solid) stop bodies right away.
class TileMap extends Node2D:
	fn onCreation(id: Int):
		super.onCreation(id)
		tilemaps[id] = self
	fn columns() -> Int:
		return int(nb_get_f(id, "columns"))
	fn rows() -> Int:
		return int(nb_get_f(id, "rows"))
	fn tileWidth() -> Float:
		return nb_get_f(id, "tileWidth")
	fn tileHeight() -> Float:
		return nb_get_f(id, "tileHeight")
	fn tileAt(col: Int, row: Int) -> Int:
		return int(nb_get_f(id, f"tile:{col},{row}"))
	fn setTile(col: Int, row: Int, tile: Int):
		nb_set_f(id, f"tile:{col},{row}", tile * 1.0)
	fn clearTile(col: Int, row: Int):
		nb_set_f(id, f"tile:{col},{row}", 0.0)
	fn fillTiles(tile: Int):
		for r in 1..rows():
			for c in 1..columns():
				nb_set_f(id, f"tile:{c},{r}", tile * 1.0)
	fn setSolid(value: Bool):
		nb_set_b(id, "solid", value)
	# world position (game units) -> column / row. Outside the map the number is below 1 or above columns() / rows().
	fn colAt(wx: Float) -> Int:
		return math.floor((wx - (nb_get_f(id, "x") - columns() * tileWidth() / 2.0)) / tileWidth()) + 1
	fn rowAt(wy: Float) -> Int:
		return math.floor((wy - (nb_get_f(id, "y") - rows() * tileHeight() / 2.0)) / tileHeight()) + 1
	fn tileAtPoint(wx: Float, wy: Float) -> Int:
		return tileAt(colAt(wx), rowAt(wy))
	# centre of a cell in game units, handy for placing a coin or an enemy on a tile
	fn cellCenter(col: Int, row: Int) -> Vec2:
		return Vec2(nb_get_f(id, "x") - columns() * tileWidth() / 2.0 + (col - 0.5) * tileWidth(), nb_get_f(id, "y") - rows() * tileHeight() / 2.0 + (row - 0.5) * tileHeight())

class Camera extends Node2D:
	fn onCreation(id: Int):
		super.onCreation(id)
		cameras[id] = self
	fn setZoom(value: Float):
		nb_set_f(id, "zoom", value)

class Sound extends Node:
	fn onCreation(id: Int):
		super.onCreation(id)
		sounds[id] = self
	fn start():
		nb_set_b(id, "_play", true)
	fn stop():
		nb_set_b(id, "_stop", true)
	fn setFile(file: String):
		nb_set_s(id, "file", file)
	fn setVolume(value: Float):
		nb_set_f(id, "volume", value)
	fn setPitch(value: Float):
		nb_set_f(id, "pitch", value)
	fn setLoop(value: Bool):
		nb_set_b(id, "loop", value)

# ---- looking nodes up -----------------------------------------------------------------
fn wrap(id: Int) -> Node:
	var known = nodes.get(id)
	if known != null:
		return known
	var t = nb_type(id)
	match t:
		case "Sprite":
			return Sprite(id)
		case "Shape":
			return Shape(id)
		case "Label":
			return Label(id)
		case "Button":
			return Button(id)
		case "Body":
			return Body(id)
		case "SpawnableBody":
			return SpawnableBody(id)
		case "TileMap":
			return TileMap(id)
		case "Camera":
			return Camera(id)
		case "Sound":
			return Sound(id)
		case "Node2D":
			return Node2D(id)
		default:
			return Node(id)

fn nodeAt(from: Int, path: String) -> Node:
	var found = nb_find(from, path)
	if found == 0:
		throw f"no node at '{path}'"
	return wrap(found)

fn nodesTagged(label: String) -> List[Node]:
	var out: List[Node] = []
	for i in 1..nb_tagged_count(label):
		out.add(wrap(nb_tagged_at(label, i)))
	return out

fn spawn(scene: String, parent: Node) -> Node:
	var made = nb_spawn(scene, parent.id)
	if made == 0:
		throw f"cannot spawn '{scene}'"
	return wrap(made)

fn asNode2D(n: Node) -> Node2D:
	var r = node2ds.get(n.id)
	if r == null:
		throw f"node '{n.name()}' is a {n.kind()}, not a Node2D"
	return r
fn asSprite(n: Node) -> Sprite:
	var r = sprites.get(n.id)
	if r == null:
		throw f"node '{n.name()}' is a {n.kind()}, not a Sprite"
	return r
fn asShape(n: Node) -> Shape:
	var r = shapes.get(n.id)
	if r == null:
		throw f"node '{n.name()}' is a {n.kind()}, not a Shape"
	return r
fn asLabel(n: Node) -> Label:
	var r = labels.get(n.id)
	if r == null:
		throw f"node '{n.name()}' is a {n.kind()}, not a Label"
	return r
fn asButton(n: Node) -> Button:
	var r = buttons.get(n.id)
	if r == null:
		throw f"node '{n.name()}' is a {n.kind()}, not a Button"
	return r
fn asBody(n: Node) -> Body:
	var r = bodies.get(n.id)
	if r == null:
		throw f"node '{n.name()}' is a {n.kind()}, not a Body"
	return r
fn asSpawnableBody(n: Node) -> SpawnableBody:
	var r = spawnables.get(n.id)
	if r == null:
		throw f"node '{n.name()}' is a {n.kind()}, not a SpawnableBody"
	return r
fn asTileMap(n: Node) -> TileMap:
	var r = tilemaps.get(n.id)
